# Reproducible builds require byte-identical files on every platform.
* text=auto eol=lf

# Hash-pinned data and known-answer vectors: never touch these bytes. Line-ending
# conversion on a Windows checkout would break `sha256sum -c data/SHA256SUMS` while
# leaving the content apparently unchanged, which is the worst kind of failure.
data/bip39-english.txt   -text
data/SHA256SUMS          -text
tests/fixtures/*.txt     -text

# Shell scripts must keep the executable bit in the index. On Windows core.filemode
# is false, so a local chmod never reaches the commit — CI then fails with Permission
# denied on a script that runs fine locally. Set it with: git update-index --chmod=+x
*.sh text eol=lf
